{
  "name": "@ah-monica/next",
  "version": "0.1.1",
  "description": "Next.js client and server adapters for the MONICA SDK",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/server/index.js"
  ],
  "files": ["dist", "README.md"],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --filter @ah-monica/core build && bun run --filter @ah-monica/node build",
    "pack:check": "bun run build && bun pm pack --dry-run",
    "test": "bun run build:dependencies && bun test",
    "test:runtime": "node --conditions react-server test/runtime-smoke.mjs",
    "test:next-build": "bun run build && node test/next-build-smoke.mjs",
    "typecheck": "bun run build:dependencies && tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accel-Hack/monica-sdk-js.git",
    "directory": "next"
  },
  "dependencies": {
    "@ah-monica/core": "0.1.1",
    "@ah-monica/node": "0.1.1",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "next": ">=15.3 <17"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.2"
  }
}
